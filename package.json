{
  "name": "snookjam",
  "private": true,
  "version": "0.1.0",
  "description": "A single-player browser game about keeping rural traffic flowing.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
